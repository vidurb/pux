<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{assigns[:page_title] || "pux"}</title>
    <meta :if={assigns[:description]} name="description" content={@description} />
    <meta name="theme-color" content="#0E3B32" />
    <link rel="canonical" href={PuxWeb.Endpoint.url() <> @conn.request_path} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="pux" />
    <meta property="og:title" content={assigns[:page_title] || "pux"} />
    <meta :if={assigns[:description]} property="og:description" content={@description} />
    <meta property="og:url" content={PuxWeb.Endpoint.url() <> @conn.request_path} />
    <meta property="og:image" content={PuxWeb.Endpoint.url() <> "/images/og-image.png"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The pux logo with the line: bank OTPs on every device, even with no signal"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="/assets/app.css" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="site-logo" href="/" aria-label="pux home"><.wordmark /></a>
        <nav aria-label="Main">
          <a href="/#why">Why pux</a>
          <a href="/#how">How it works</a>
          <a href="/#banks">Banks</a>
          <a href="/#security">Security</a>
          <a href="/#faq">FAQ</a>
          <a href="https://github.com/vidurb/pux">Source</a>
        </nav>
      </div>
    </header>
    <main id="main">
      {@inner_content}
    </main>
    <footer class="site-footer">
      <div class="wrap site-footer__row">
        <.wordmark />
        <p>Free software under the AGPL-3.0. Not affiliated with any bank.</p>
        <nav aria-label="Footer">
          <a href="https://github.com/vidurb/pux">Source</a>
          <a href="https://github.com/vidurb/pux/blob/main/SECURITY.md">Security policy</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
