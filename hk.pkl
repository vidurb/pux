amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

steps {
  // correctness: actionlint-style checks only; pedantic policy rules stay CI follow-up
  ["jactionlint"] = (Builtins.jactionlint) {
    check = "jactionlint --profile correctness --format gcc {{files}}"
    fix = "jactionlint --profile correctness --fix {{files}}"
  }
  ["mix-fmt"] = (Builtins.mix_fmt) {
    workspace_indicator = "mix.exs"
    dir = "{{workspace}}"
    glob = List("**/*.{ex,exs,heex}")
    exclude = List("deps/**")
  }
  ["dart-format"] {
    workspace_indicator = "pubspec.yaml"
    dir = "{{workspace}}"
    glob = List("**/*.dart")
    check = "dart format --output=none --set-exit-if-changed {{files}}"
    fix = "dart format {{files}}"
  }
  ["dart-analyze"] {
    workspace_indicator = "pubspec.yaml"
    dir = "{{workspace}}"
    glob = List("lib/**/*.dart", "test/**/*.dart")
    check = "dart analyze {{files}}"
  }
}

hooks {
  // release-please reads commit messages to pick versions and write the
  // changelog, so they must be Conventional Commits (see AGENTS.md).
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
