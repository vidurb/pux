# Copy to deploy/.env (gitignored) and fill in. Generate secrets with:
#   openssl rand -base64 48   (SECRET_KEY_BASE)
#   openssl rand -base64 24   (salts, database password)

# Image tag: a release such as 0.1.0, or `main` for the latest build of main.
PUX_VERSION=latest

# Public hostname of the HTTPS site and API (your reverse proxy terminates TLS here).
PHX_HOST=pux.example.com
# Domain for inbox addresses (<token>@MAIL_DOMAIN); defaults to PHX_HOST. Needs an MX record pointing at this host.
MAIL_DOMAIN=

POSTGRES_PASSWORD=
SECRET_KEY_BASE=
LIVE_VIEW_SIGNING_SALT=
COOKIE_SIGNING_SALT=

# SMTP STARTTLS (strongly recommended). Paths inside the container; ./certs is mounted at /certs.
SMTP_TLS_CERTFILE=
SMTP_TLS_KEYFILE=
SMTP_REQUIRE_TLS=false

# Firebase service account JSON (one line) for Android/iOS push. Only works with app builds that use
# the same Firebase project, so you need your own Firebase project and app build. Desktop apps don't need it.
FCM_SERVICE_ACCOUNT_JSON=

# Optional limits. Leave empty for the defaults; the README's environment table explains each.
POOL_SIZE=
MAX_DEVICES_PER_RECORD=
RECORD_API_RATE_LIMIT=
AUTH_FAILURE_RATE_LIMIT=
SMTP_MAX_MESSAGE_SIZE=
SMTP_MAX_CONNECTIONS=
SMTP_MAX_CONNECTIONS_PER_IP=
SMTP_INBOUND_RATE_LIMIT=
SMTP_INBOUND_RATE_SCALE_MS=
