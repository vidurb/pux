{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this tags the release and starts the builds. The release stays a draft until every build is attached.",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverted" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "pux",
      "extra-files": [
        { "type": "generic", "path": "server/mix.exs" },
        { "type": "generic", "path": "mobile/pubspec.yaml" },
        { "type": "generic", "path": "README.md" }
      ]
    }
  }
}
